<Project Sdk="Microsoft.NET.Sdk">

  <!--
    An E# library with C of its own (issue #31): Adler32.cs declares the C function cksum_adler32 as a [Native] extern (with a C#
    version for the dotnet host build), and native/ holds the C: native/common/ for every target, native/m68k/ for m68k only (a
    file there replaces the common file of the same name). See samples/packages/README.md and docs/GUIDE.md, "C in a library".
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <EsLibrary>true</EsLibrary>
    <EsTargets>m68k;os4;morphos;aros;aros-i386;sdl</EsTargets>
    <!-- Native: it declares a [Native] extern; NativeC: it brings C files (native/). -->
    <EsFeatures>Native;NativeC</EsFeatures>
    <!-- Every C name its C files export starts with this (the default would be esharpsample_checksum_). -->
    <EsNativePrefix>cksum_</EsNativePrefix>

    <IsPackable>true</IsPackable>
    <PackageId>ESharpSample.Checksum</PackageId>
    <Version>1.0.0</Version>
    <Authors>Gyrafe Software</Authors>
    <Description>Sample E# library with C of its own: an Adler-32 checksum in C, with a C# version for the dotnet host (samples/packages in the E# repository).</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <ESharpSdkVersion Condition="'$(ESharpSdkVersion)' == ''">0.1.0-dev</ESharpSdkVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AmigaESharp.Sdk" Version="$(ESharpSdkVersion)" />
  </ItemGroup>

</Project>
