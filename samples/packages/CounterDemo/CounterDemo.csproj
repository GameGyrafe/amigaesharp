<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A game that uses the E# library ESharpSample.Counter (../Counter) from a NuGet feed: a window class derived from the platform's
    GtWindow. See samples/packages/README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);HOST</DefineConstants>
    <ESharpSdkVersion Condition="'$(ESharpSdkVersion)' == ''">0.1.0-dev</ESharpSdkVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AmigaESharp.Sdk" Version="$(ESharpSdkVersion)" />
    <PackageReference Include="ESharpSample.Counter" Version="1.0.0" />
  </ItemGroup>

</Project>
