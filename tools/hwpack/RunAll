; E# hardware test pack. Run from this drawer:  Execute RunAll        (after a crash and reset: Execute RunAll RESUME)
; (AmigaDOS comments start with a semicolon at the beginning of a line only.)
; For every program: results/NAME.txt (its output), results/NAME.sum (its ok/FAIL counts) and a line in SUMMARY.txt.
; results/PROGRESS.txt names the program that was started last, so a crash or hang can be pinned on one program.
; Programs that show a picture or play sound are unattended too: look and listen (README.txt), press Esc or wait.
.KEY resume/S
.BRA {
.KET }

FailAt 1000
Stack 16000
If "{resume}" EQ "RESUME"
  Echo "" >T:hwpack-resume
  Echo "" >>SUMMARY.txt
  Echo "--- resumed run ---" >>SUMMARY.txt
Else
  If EXISTS T:hwpack-resume
    Delete T:hwpack-resume QUIET
  EndIf
  If EXISTS results/PROGRESS.txt
    Delete results/#? QUIET
  EndIf
  Echo "E# hardware test pack" >SUMMARY.txt
  Type BUILD >>SUMMARY.txt
  Date >>SUMMARY.txt
  Echo "" >>SUMMARY.txt
  Echo "hwinfo (machine report)"
  hwinfo >results/hwinfo.txt
  Type results/hwinfo.txt
  Type results/hwinfo.txt >>SUMMARY.txt
  Echo "" >>SUMMARY.txt
  Echo "Programs (ok / FAIL / skip counts; an arrow at the end of a line marks anything to look at):" >>SUMMARY.txt
EndIf
Echo "started:" >>results/TIMES.txt
Date >>results/TIMES.txt

Execute RunOne hello hello text
Execute RunOne phase2 phase2 32
Execute RunOne memory memory 19
Execute RunOne generics generics 24
Execute RunOne properties properties 18
Execute RunOne operators operators 20
Execute RunOne language language 39
Execute RunOne collections collections 20
Execute RunOne inherit inherit 24
Execute RunOne lambdas lambdas 16
Execute RunOne linq linq 37
Execute RunOne refs refs 18
Execute RunOne patterns patterns 23
Execute RunOne objects objects 21
Echo "(objects-args: the same program with AmigaDOS arguments)"
Execute RunOne objects-args objects 21 "SEED=42 auto"
Echo "(mainargs: prints its arguments and ends with return code 3)"
Execute RunOne mainargs mainargs text "ONE *"two words*" RC=3"
Execute RunOne names names 12
Execute RunOne dates dates 19
Echo "(interrupts: a vertical-blank server counts frames)"
Execute RunOne interrupts interrupts 14
Echo "(trace: also writes 9 lines to the serial port)"
Execute RunOne trace trace text
Echo "(timing: a second of vertical blanks)"
Execute RunOne timing timing 10
Echo "(fonts: text in topaz and, if installed, a disk font)"
Execute RunOne fonts fonts 8
Echo "(iff: writes and reads back an IFF file in RAM:)"
Execute RunOne iff iff 10
Echo "(controls: timer and joystick: move the stick in port 1 if you like)"
Execute RunOne controls controls 12
Echo "(keys: a blank screen: press A within 10 seconds, or wait)"
Execute RunOne keys keys 8
Echo "(asl: allocation checks only; the requester is a by-eye test, see README.txt)"
Execute RunOne asl asl 3
Echo "(screen: a card picture appears for a few seconds)"
Execute RunOne screen screen 23
Echo "(aga: a 256 colour picture appears for a few seconds)"
Execute RunOne aga aga 6
Echo "(assets: dithered gradients and a badge appear; a short beep)"
Execute RunOne assets assets 17
Execute RunOne rtg rtg 5
Echo "(sound: you should hear tones)"
Execute RunOne sound sound 21
Echo "(dbuffer: a moving bar flips between two buffers for a few seconds)"
Execute RunOne dbuffer dbuffer 30
Echo "(textspeed: a screen of text, then a speed note)"
Execute RunOne textspeed textspeed 1
Echo "(cards: a round of higher/lower; Esc quits, or leave it for about 10 seconds)"
Execute RunOne cards cards 15
Echo "(rummy: a game of rummy; Esc quits, or leave it for about 10 seconds)"
Execute RunOne rummy rummy 28

Echo "finished:" >>results/TIMES.txt
Date >>results/TIMES.txt
Echo "" >>SUMMARY.txt
Echo "Start and finish times:" >>SUMMARY.txt
Type results/TIMES.txt >>SUMMARY.txt
Echo "" >>SUMMARY.txt
If EXISTS results/FLAGS.txt
  Echo "Programs with a FAIL line, no output, a return code of 5 or more, or a different ok count (see their lines above):" >>SUMMARY.txt
  Type results/FLAGS.txt >>SUMMARY.txt
Else
  Echo "Every program printed the emulator's ok count and no FAIL line." >>SUMMARY.txt
EndIf
Echo "" >>SUMMARY.txt
Echo "Done. Send SUMMARY.txt, the results drawer and the answers in README.txt (section 4) back."
