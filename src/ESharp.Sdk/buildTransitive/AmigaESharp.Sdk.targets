<Project>
  <!--
    E# library packages (issue #31), shipped in AmigaESharp.Sdk. A class library that sets EsLibrary=true is an E# library: its
    DLL (the HOST build, for the IDE and dotnet test) also carries
      esharp/library.json   the manifest: format, id, version, targets, minSdk, features, license
      esharp/src/<path>     each C# source of the project, as written
    as embedded resources. esharp build reads the sources back from the restored package and compiles them with the program for
    the chosen target, so every #if branch is there.

    Properties of the library project:
      EsLibrary          true to make the project an E# library
      EsTargets          the targets it supports, ';'-separated: m68k;os4;morphos;aros;aros-i386;sdl (required)
      EsFeatures         platform-level features its code uses, ';'-separated: AmigaLib (raw [AmigaLib] bindings), Native ([Native]
                         externs), InlineAsm ([InlineAsm] bodies), Interrupt ([Interrupt]
                         servers), HookEntry ([HookEntry] methods); esharp build refuses an undeclared one and prints the declared ones
      EsMinSdkVersion    the oldest E# (esharp tool) it works with; default: the version of this AmigaESharp.Sdk
      PackageLicenseExpression   the licence (SPDX); a GPL-family licence is a build error in programs that use it unless they opt in
      DefineConstants    the library's own symbols (other than DEBUG, TRACE, RELEASE and HOST) go into the manifest ("defines") and
                         esharp build defines them for the library's files only; an E# target symbol (AMIGA, M68K, SDL, ...) is refused
    Every file needs its own using lines: ImplicitUsings and <Using> items are refused (their generated file is not embedded).

    Assets: a library with an assets.json in its project folder ships the Assets.g.cs that `esharp assets <library dir>` writes next
    to it (commit it, as for a program). That file is an ordinary source of the library, so it is in the HOST DLL and in esharp/src/,
    and the manifest names it ("assets": source, namespace, class). The PNG, ILBM and sound inputs are not packed: the game's build
    compiles the converted data exactly as it compiles a program's own Assets.g.cs. assets.json must set "namespace" (the library's
    own), so the asset class cannot collide with the game's or another package's. A missing Assets.g.cs stops the build (ESL005);
    one older than assets.json or an input it lists is a warning (ESL011: run esharp assets again).
    C files are refused here (ESL006) and by esharp build: C# and assets only for now.
  -->

  <UsingTask TaskName="EsWriteLibraryManifest" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <OutputFile Required="true" />
      <Id />
      <Version />
      <Targets ParameterType="System.String[]" />
      <MinSdk />
      <Features ParameterType="System.String[]" />
      <Defines ParameterType="System.String[]" />
      <License />
      <AssetsSource />
      <AssetsNamespace />
      <AssetsClass />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        // A small JSON writer: every string goes through Quote (backslash, quote and control characters escaped), so a PackageId or
        // licence with those characters still gives valid JSON. (System.Text.Json is not available to inline tasks on every host.)
        Func<string, string> Quote = text =>
        {
            var sb = new StringBuilder("\"");
            foreach (var c in text ?? "")
            {
                if (c == '"') sb.Append("\\\"");
                else if (c == '\\') sb.Append("\\\\");
                else if (c < ' ') sb.Append("\\u").Append(((int)c).ToString("x4"));
                else sb.Append(c);
            }
            return sb.Append('"').ToString();
        };
        Func<string[], string> List = values =>
        {
            var parts = new System.Collections.Generic.List<string>();
            foreach (var v in values ?? new string[0]) parts.Add(Quote(v));
            return "[" + string.Join(", ", parts) + "]";
        };
        var json = "{ \"format\": 1, \"id\": " + Quote(Id) + ", \"version\": " + Quote(Version) + ", \"targets\": " + List(Targets) +
                   ", \"minSdk\": " + Quote(MinSdk) + ", \"features\": " + List(Features) + ", \"defines\": " + List(Defines) +
                   ", \"license\": " + Quote(License) +
                   (string.IsNullOrEmpty(AssetsSource) ? "" : ", \"assets\": { \"source\": " + Quote(AssetsSource) + ", \"namespace\": " + Quote(AssetsNamespace) +
                                                              ", \"class\": " + Quote(AssetsClass) + " }") + " }\n";
        System.IO.Directory.CreateDirectory(System.IO.Path.GetDirectoryName(System.IO.Path.GetFullPath(OutputFile)));
        // Only when different, so an unchanged manifest does not make the build think the library changed.
        if (!System.IO.File.Exists(OutputFile) || System.IO.File.ReadAllText(OutputFile) != json)
            System.IO.File.WriteAllText(OutputFile, json, new UTF8Encoding(false));
      ]]></Code>
    </Task>
  </UsingTask>

  <UsingTask TaskName="EsCheckLibraryAssets" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Manifest Required="true" />
      <Generated Required="true" />
      <Namespace Output="true" />
      <Class Output="true" />
      <Stale Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        // Only what the build needs from assets.json: the namespace and class of the generated file, and the input files (for the
        // age check). A light reading (System.Text.Json is not available to inline tasks on every host); esharp assets reads it in full.
        const string str = "\"((?:[^\"\\\\]|\\\\.)*)\"";   // a JSON string, its text in group 1
        var text = File.ReadAllText(Manifest);
        // Comments (esharp assets allows them) become spaces; strings stay as they are.
        text = Regex.Replace(text, str + "|//[^\\n]*|/\\*.*?\\*/", m => m.Value.StartsWith("\"") ? m.Value : " ", RegexOptions.Singleline);
        Func<string, string> Top = key =>
        {
            var m = Regex.Match(text, "\"" + key + "\"\\s*:\\s*" + str);
            return m.Success ? m.Groups[1].Value.Trim() : "";
        };
        Namespace = Top("namespace");
        Class = Top("class");
        if (Class.Length == 0) Class = "Assets";
        var dir = Path.GetDirectoryName(Path.GetFullPath(Manifest));
        var built = File.Exists(Generated) ? File.GetLastWriteTimeUtc(Generated) : DateTime.MinValue;
        var newer = new System.Collections.Generic.List<string>();
        if (File.GetLastWriteTimeUtc(Manifest) > built) newer.Add(Path.GetFileName(Manifest));
        foreach (Match m in Regex.Matches(text, "\"file\"\\s*:\\s*" + str))
        {
            var name = m.Groups[1].Value.Replace("\\\\", "\\").Replace("\\/", "/");
            var input = Path.Combine(dir, name.Replace('/', Path.DirectorySeparatorChar));
            if (!File.Exists(input)) newer.Add(name + " (missing)");
            else if (File.GetLastWriteTimeUtc(input) > built) newer.Add(name);
        }
        Stale = string.Join(", ", newer);
      ]]></Code>
    </Task>
  </UsingTask>

  <PropertyGroup Condition="'$(EsLibrary)' == 'true'">
    <!-- The library's own symbols, before HOST is added: they go into the manifest for the Amiga parse of its files. -->
    <_EsUserDefines>$(DefineConstants)</_EsUserDefines>
    <!-- The same symbol the esharp host build defines: the DLL is the HOST build of the library. -->
    <DefineConstants>$(DefineConstants);HOST</DefineConstants>
    <PackageTags>$(PackageTags);esharp</PackageTags>
    <!-- The SDK would give a file from outside the project folder a Link of its file name; here only a Link written in the project counts
         (a Compile item outside without one, such as source-only package contentFiles, is not the library's own source and is skipped). -->
    <SetLinkMetadataAutomatically Condition="'$(SetLinkMetadataAutomatically)' == ''">false</SetLinkMetadataAutomatically>
    <_EsLibraryManifest>$(IntermediateOutputPath)esharp-library.json</_EsLibraryManifest>
  </PropertyGroup>

  <Target Name="EsLibraryEmbedSources" BeforeTargets="BeforeBuild" Condition="'$(EsLibrary)' == 'true'">
    <!-- The version of this AmigaESharp.Sdk, from the nuspec next to this file in the restored package (no nuspec: no default). -->
    <XmlPeek Condition="'$(EsMinSdkVersion)' == '' and Exists('$(MSBuildThisFileDirectory)../amigaesharp.sdk.nuspec')"
             XmlInputPath="$(MSBuildThisFileDirectory)../amigaesharp.sdk.nuspec"
             Query="/*[local-name()='package']/*[local-name()='metadata']/*[local-name()='version']/text()">
      <Output TaskParameter="Result" PropertyName="EsMinSdkVersion" />
    </XmlPeek>

    <ItemGroup>
      <_EsTarget Include="$(EsTargets)" />
      <_EsUnknownTarget Include="@(_EsTarget)" Exclude="m68k;os4;morphos;aros;aros-i386;sdl" />
      <_EsFeature Include="$(EsFeatures)" />
      <_EsUnknownFeature Include="@(_EsFeature)" Exclude="AmigaLib;Native;InlineAsm;Interrupt;HookEntry" />
      <!-- DEBUG/TRACE/RELEASE come from the configuration (esharp build sets DEBUG and TRACE itself); HOST is this step's own. -->
      <_EsDefine Include="$([MSBuild]::Unescape($(_EsUserDefines.Replace(',', ';').Replace(' ', ''))))" Exclude="DEBUG;TRACE;RELEASE;HOST" />
      <_EsReservedDefine Include="@(_EsDefine)" Condition="'%(Identity)' == 'AMIGA' or '%(Identity)' == 'M68K' or '%(Identity)' == 'PPC' or '%(Identity)' == 'X86_64' or '%(Identity)' == 'I386' or '%(Identity)' == 'AMIGAOS3' or '%(Identity)' == 'AMIGAOS4' or '%(Identity)' == 'MORPHOS' or '%(Identity)' == 'AROS' or '%(Identity)' == 'SDL'" />
    </ItemGroup>
    <Error Condition="'$(EsTargets)' == ''" Code="ESL001"
           Text="E# library: set EsTargets to the targets the library supports, ';'-separated (m68k;os4;morphos;aros;aros-i386;sdl)" />
    <Error Condition="'@(_EsUnknownTarget)' != ''" Code="ESL002"
           Text="E# library: unknown target(s) in EsTargets: @(_EsUnknownTarget) (known: m68k;os4;morphos;aros;aros-i386;sdl)" />
    <Error Condition="'@(_EsUnknownFeature)' != ''" Code="ESL003"
           Text="E# library: unknown feature(s) in EsFeatures: @(_EsUnknownFeature) (known: AmigaLib;Native;InlineAsm;Interrupt;HookEntry)" />
    <Error Condition="'$(ImplicitUsings)' == 'enable' or '$(ImplicitUsings)' == 'true'" Code="ESL004"
           Text="E# library: set ImplicitUsings to disable; the Amiga build compiles only the embedded sources, so every file needs its own using lines" />
    <Error Condition="'@(Using)' != ''" Code="ESL008"
           Text="E# library: &lt;Using&gt; items (@(Using)) are not supported; the Amiga build compiles only the embedded sources, so put the using lines in each file" />
    <Error Condition="'@(_EsReservedDefine)' != ''" Code="ESL009"
           Text="E# library: DefineConstants sets the E# target symbol(s) @(_EsReservedDefine); esharp build defines those for the chosen target" />

    <!-- Assets: the Assets.g.cs that esharp assets writes next to assets.json is the package's asset data (see the top of this file). -->
    <PropertyGroup>
      <_EsAssetsManifest Condition="Exists('$(MSBuildProjectDirectory)/assets.json')">$(MSBuildProjectDirectory)/assets.json</_EsAssetsManifest>
      <_EsAssetsSourceName Condition="'$(_EsAssetsManifest)' != ''">Assets.g.cs</_EsAssetsSourceName>
      <_EsAssetsSource Condition="'$(_EsAssetsManifest)' != ''">$(MSBuildProjectDirectory)/Assets.g.cs</_EsAssetsSource>
    </PropertyGroup>
    <Error Condition="'$(_EsAssetsManifest)' != '' and !Exists('$(_EsAssetsSource)')" Code="ESL005"
           Text="E# library: assets.json has no Assets.g.cs next to it; run esharp assets $(MSBuildProjectDirectory) (and commit the file it writes), so the package carries the converted assets" />
    <EsCheckLibraryAssets Condition="'$(_EsAssetsManifest)' != ''" Manifest="$(_EsAssetsManifest)" Generated="$(_EsAssetsSource)">
      <Output TaskParameter="Namespace" PropertyName="_EsAssetsNamespace" />
      <Output TaskParameter="Class" PropertyName="_EsAssetsClass" />
      <Output TaskParameter="Stale" PropertyName="_EsAssetsStale" />
    </EsCheckLibraryAssets>
    <Error Condition="'$(_EsAssetsManifest)' != '' and '$(_EsAssetsNamespace)' == ''" Code="ESL012"
           Text="E# library: assets.json sets no &quot;namespace&quot;; give the assets the library's own namespace, so their class cannot collide with the game's or another package's" />
    <Warning Condition="'$(_EsAssetsManifest)' != '' and '$(_EsAssetsStale)' != ''" Code="ESL011"
             Text="E# library: Assets.g.cs is older than $(_EsAssetsStale); run esharp assets $(MSBuildProjectDirectory) so the package carries the current assets" />

    <PropertyGroup>
      <_EsObjDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)'))</_EsObjDir>
      <_EsBinDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(BaseOutputPath)'))</_EsBinDir>
    </PropertyGroup>
    <ItemGroup>
      <_EsSource Include="@(Compile)" EsPath="$([MSBuild]::MakeRelative('$(MSBuildProjectDirectory)/', '%(Compile.FullPath)'))" />
      <_EsSource Condition="'%(_EsSource.Link)' != ''" EsPath="%(_EsSource.Link)" />
      <!-- Generated files (AssemblyInfo and the like, under obj/) are not part of the library's source. -->
      <_EsSource Remove="@(_EsSource)" Condition="$([System.String]::Copy('%(_EsSource.FullPath)').StartsWith('$(_EsObjDir)')) or $([System.String]::Copy('%(_EsSource.FullPath)').StartsWith('$(_EsBinDir)'))" />
      <!-- A file from outside the project folder without a Link (source-only package contentFiles, for one) is not the library's own
           source: it is skipped, with a warning (it is still in the HOST DLL, so the Amiga build would miss it). Give it a Link to embed
           it. Outside: a relative path that leaves the folder, or an absolute one (a file on another drive on Windows). -->
      <_EsSource Condition="'%(_EsSource.Link)' == '' and ($([System.String]::Copy('%(_EsSource.EsPath)').StartsWith('..')) or $([System.IO.Path]::IsPathRooted('%(_EsSource.EsPath)')))" EsOutside="true" />
      <_EsSkipped Include="@(_EsSource)" Condition="'%(_EsSource.EsOutside)' == 'true'" />
      <_EsSource Remove="@(_EsSkipped)" />
      <_EsAssetsEmbedded Include="@(_EsSource)" Condition="'$(_EsAssetsSourceName)' != '' and '%(_EsSource.EsPath)' == '$(_EsAssetsSourceName)'" />
      <_EsCFile Include="@(None)" Condition="'%(None.Extension)' == '.c' or '%(None.Extension)' == '.h'" />
      <_EsCFile Include="@(Content)" Condition="'%(Content.Extension)' == '.c' or '%(Content.Extension)' == '.h'" />
    </ItemGroup>
    <Warning Condition="'%(_EsSkipped.FullPath)' != ''" Code="ESL010"
             Text="E# library: %(_EsSkipped.FullPath) is outside the project folder and has no Link, so it is not embedded (esharp build will not see it, though the HOST DLL has it); give the Compile item a Link to embed it" />
    <Error Condition="'$(_EsAssetsSourceName)' != '' and '@(_EsAssetsEmbedded)' == ''" Code="ESL013"
           Text="E# library: Assets.g.cs is not compiled (a Compile Remove?); it is the package's asset data, so leave it in the project" />
    <Error Condition="'@(_EsCFile)' != ''" Code="ESL006"
           Text="E# library: C files and headers in packages are not supported yet (@(_EsCFile)); E# library packages are C# only for now" />

    <!-- The manifest is written by a JSON string writer, so quotes and backslashes in PackageId or the licence stay valid. -->
    <EsWriteLibraryManifest OutputFile="$(_EsLibraryManifest)" Id="$(PackageId)" Version="$(PackageVersion)" Targets="@(_EsTarget)"
                            MinSdk="$(EsMinSdkVersion)" Features="@(_EsFeature)" Defines="@(_EsDefine)" License="$(PackageLicenseExpression)"
                            AssetsSource="$(_EsAssetsSourceName)"
                            AssetsNamespace="$(_EsAssetsNamespace)" AssetsClass="$(_EsAssetsClass)" />
    <ItemGroup>
      <FileWrites Include="$(_EsLibraryManifest)" />
      <EmbeddedResource Include="$(_EsLibraryManifest)" LogicalName="esharp/library.json" Type="Non-Resx" WithCulture="false" />
      <EmbeddedResource Include="@(_EsSource)" LogicalName="esharp/src/$([System.String]::Copy('%(_EsSource.EsPath)').Replace('\', '/'))" Type="Non-Resx" WithCulture="false" />
    </ItemGroup>
  </Target>
</Project>
